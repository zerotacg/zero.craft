{
  "name": "zero.craft",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf build/*",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "build": "react-router build",
    "postbuild": "cd build/client && mv assets data locales textures favicon.ico __spa-fallback.html *.gif *.png manifest.json robots.txt zero.craft",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "ci:start": "http-server --port 5173 ./build/client",
    "ci:cypress": "start-server-and-test ci:start http://localhost:5173 cy:run"
  },
  "dependencies": {
    "@react-router/node": "7.5.2",
    "@react-router/serve": "7.5.2",
    "bootstrap": "^5.3.5",
    "i18next": "22.4.15",
    "i18next-http-backend": "3.0.2",
    "isbot": "5.1.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "12.2.2",
    "react-router": "7.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "^7.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/cypress": "^10.0.3",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "benchmark": "^2.1.0",
    "cypress": "14.3.2",
    "react-router-devtools": "^1.1.0",
    "rimraf": "^2.5.1",
    "serve": "^14.2.4",
    "http-server": "14.1.1",
    "start-server-and-test": "^2.0.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
