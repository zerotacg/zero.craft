{
  "name": "zero.craft",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf build/*",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "build": "react-router build",
    "postbuild": "cd build/client && mv assets data locales textures favicon.ico __spa-fallback.html *.gif *.png manifest.json robots.txt zero.craft",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "ci:start": "http-server --port 5173 ./build/client",
    "ci:cypress": "start-server-and-test ci:start http://localhost:5173 cy:run"
  },
  "dependencies": {
    "@react-router/node": "7.5.2",
    "@react-router/serve": "7.5.2",
    "bootstrap": "5.3.7",
    "i18next": "25.3.2",
    "i18next-http-backend": "3.0.2",
    "isbot": "5.1.29",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "15.6.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.5.2",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/cypress": "10.0.3",
    "@types/node": "24.2.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "benchmark": "2.1.4",
    "cypress": "14.5.4",
    "react-router-devtools": "5.0.6",
    "rimraf": "6.0.1",
    "serve": "14.2.4",
    "http-server": "14.1.1",
    "start-server-and-test": "2.0.13",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vite-tsconfig-paths": "5.1.4"
  }
}
