{
  "name": "zero.craft",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf build/*",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "build": "react-router build",
    "postbuild": "cd build/client && mv assets data locales textures favicon.ico __spa-fallback.html *.gif *.png manifest.json robots.txt zero.craft",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "ci": "npm install && npm run clean && npm run build && npm run ci:cypress",
    "ci:cypress": "start-server-and-test ci:start http://localhost:5173 cy:run",
    "ci:start": "http-server --port 5173 ./build/client"
  },
  "dependencies": {
    "@react-router/node": "7.9.3",
    "@react-router/serve": "7.9.3",
    "bootstrap": "5.3.8",
    "i18next": "25.10.10",
    "i18next-http-backend": "3.0.6",
    "isbot": "5.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "16.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.9.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/cypress": "10.1.0",
    "@types/node": "24.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "benchmark": "2.1.4",
    "cypress": "15.3.0",
    "react-router-devtools": "5.1.6",
    "rimraf": "6.0.1",
    "serve": "14.2.5",
    "http-server": "14.1.1",
    "start-server-and-test": "2.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "6.1.1"
  }
}
